---
// Call-to-action band: one heading or sentence plus one or two buttons.
// tone="mist" is the default; use tone="ink" only where the page has no other ink band
// (DESIGN.md: large ink blocks at most once per page, the footer aside).
interface Action { label: string; href: string; external?: boolean }
interface Props {
  title: string;
  text?: string;
  primary: Action;
  secondary?: Action;
  tone?: 'mist' | 'ink';
  kicker?: string;
  id?: string;
}
const { title, text, primary, secondary, tone = 'mist', kicker, id = 'cta-' + Math.random().toString(36).slice(2, 8) } = Astro.props;
const dark = tone === 'ink';
const ext = (a: Action) => (a.external ? { rel: 'noopener', target: '_blank' } : {});
---
<section class:list={['cta-band', `cta-band--${tone}`]} aria-labelledby={id}>
  <div class="container cta-band__inner">
    <div class="cta-band__text">
      {kicker && <p class="cta-band__kicker">{kicker}</p>}
      <h2 id={id}>{title}</h2>
      {text && <p class="cta-band__lead">{text}</p>}
    </div>
    <div class="btn-row cta-band__actions">
      <a class:list={['btn', dark && 'btn--on-dark']} href={primary.href} {...ext(primary)}>
        {primary.label}{primary.external && <span class="visually-hidden"> (opens in a new tab)</span>}
      </a>
      {secondary && (
        <a class:list={['btn', dark ? 'btn--on-dark-secondary' : 'btn--secondary']} href={secondary.href} {...ext(secondary)}>
          {secondary.label}{secondary.external && <span class="visually-hidden"> (opens in a new tab)</span>}
        </a>
      )}
    </div>
  </div>
</section>
<style>
  .cta-band { padding: var(--s-6) 0; }
  .cta-band--mist { background: var(--mist); border-top: 4px solid var(--ink); }
  .cta-band--ink { background: var(--ink); color: var(--on-dark); }
  .cta-band__inner { display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--s-3) var(--gutter); align-items: end; }
  .cta-band__text { grid-column: 1 / span 7; }
  .cta-band__actions { grid-column: 9 / span 4; justify-content: flex-start; }
  .cta-band h2 { font-size: var(--fs-h2); line-height: 1.15; letter-spacing: -0.015em; max-width: 30ch; }
  .cta-band__kicker { font: 600 var(--fs-kicker)/1.4 var(--sans); letter-spacing: .1em; text-transform: uppercase; margin: 0 0 var(--s-1); color: var(--mute-dark); }
  .cta-band__lead { margin: var(--s-2) 0 0; max-width: var(--measure); color: var(--mute-dark); }
  .cta-band--ink .cta-band__kicker, .cta-band--ink .cta-band__lead { color: var(--on-dark-mute); }
  .cta-band--ink :focus-visible { outline-color: var(--white); }
  @media (max-width: 960px) {
    .cta-band__text, .cta-band__actions { grid-column: 1 / -1; }
  }
  @media (max-width: 600px) { .cta-band { padding: var(--s-5) 0; } }
</style>
