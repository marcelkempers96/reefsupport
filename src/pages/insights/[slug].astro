---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Kicker from '../../components/Kicker.astro';
import JsonLd from '../../components/JsonLd.astro';
import CardGrid from '../../components/CardGrid.astro';
import InsightCard from '../../components/InsightCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getAreas, getInsights, formatDate, type Insight } from '../../lib/data';

export async function getStaticPaths() {
  const posts = await getInsights();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
interface Props { post: Insight }
const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const areas = await getAreas();
const areaById = Object.fromEntries(areas.map((a) => [a.id, a]));
const area = d.area ? areaById[d.area] : undefined;
const more = (await getInsights()).filter((p) => p.id !== post.id).slice(0, 3);
const areaLink = area ? { label: `Projects in ${area.data.name.toLowerCase()}`, href: `/projects?area=${area.id}` } : { label: 'See our projects', href: '/projects' };
const iso = d.date.toISOString().slice(0, 10);
const ld = {
  '@type': 'Article',
  headline: d.title,
  description: d.summary,
  datePublished: iso,
  author: { '@type': d.author === 'Reef Support' ? 'Organization' : 'Person', name: d.author },
  publisher: { '@type': 'Organization', name: 'Reef Support', '@id': new URL('/#organization', Astro.site).href },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---
<Base title={d.title} description={d.summary}>
  <JsonLd slot="head" data={ld} />
  <article>
    <header class="head">
      <div class="container">
        <a class="back-link" href="/insights"><span aria-hidden="true">←</span> Insights</a>
        <Kicker parts={[d.type, ...(area ? [area.data.name] : [])]} colour={area?.data.colour} />
        <h1>{d.title}</h1>
        <p class="meta byline"><time datetime={iso}>{formatDate(d.date)}</time> · {d.author}</p>
      </div>
    </header>
    <div class="container">
      <div class="prose body"><Content /></div>
      <div class="share-wrap"><ShareLinks title={d.title} label="Share this note" /></div>
    </div>
  </article>
  <CtaBand
    title="Questions about this note, or work like it?"
    text="Send a short note on where you work and what you need to measure, and we will reply within five working days."
    primary={{ label: 'Contact the team', href: '/contact' }}
    secondary={areaLink}
  />
  {more.length > 0 && (
    <section class="section rule-top" aria-labelledby="more-h">
      <div class="container">
        <h2 id="more-h" class="mb">More field notes</h2>
        <CardGrid>{more.map((p) => <InsightCard post={p} area={p.data.area ? areaById[p.data.area] : undefined} />)}</CardGrid>
      </div>
    </section>
  )}
  <Newsletter />
</Base>
<style>
  .head { padding: var(--s-6) 0 var(--s-4); }
  h1 { max-width: 880px; }
  .byline { color: var(--mute); margin-top: var(--s-2); }
  .body { padding: var(--s-4) 0 var(--s-5); border-top: 1px solid var(--line); }
  .share-wrap { max-width: var(--measure); padding-bottom: var(--s-6); }
  .mb { margin-bottom: var(--s-4); }
</style>
