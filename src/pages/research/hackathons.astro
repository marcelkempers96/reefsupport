---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SubNav from '../../components/SubNav.astro';
import ListRows from '../../components/ListRows.astro';
import subnav from '../../data/subnav.json';
import research from '../../data/research.json';
import { liveUrl } from '../../lib/data';
const hacks = await Promise.all(research.hackathons.map(async (h) => ({ ...h, url: await liveUrl(h.url) })));
const rows = hacks.map((h) => ({ type: 'Challenge', colour: 'sky', title: h.title, source: h.partners, year: h.date, url: h.url }));
const lead = 'Six open AI challenges since 2021 on coral reef image classification, segmentation and bleaching, run with FruitPunch AI, Sustainable Ocean Alliance, OceanHub Africa, Zindi and others.';
---
<Base title="Hackathons" description={lead}>
  <PageHeader kicker={['Research', 'Hackathons']} title="Open AI challenges and hackathons" lead={lead} />
  <SubNav label="Research" links={subnav.research} />
  <section class="section">
    <div class="container">
      <ListRows rows={rows} />
      <p class="note">To propose a challenge with us, <a href="/contact">get in touch</a>.</p>
    </div>
  </section>
</Base>
<style>.note { margin-top: var(--s-4); color: var(--mute); } .note a { color: var(--ink); font-weight: 600; }</style>
