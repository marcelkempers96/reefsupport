---
// List rows (DESIGN.md): ink top rule, 1 px dividers; type label with colour square,
// title (500), source (mute), year right-aligned in Plex Mono.
import Txt from './Txt.astro';
import { realUrl } from '../lib/confirm';
export interface Row { type?: string; colour?: string; title: string; source?: string; year?: string; url?: string | null }
interface Props { rows: Row[] }
const { rows } = Astro.props;
---
<ul class="rows">
  {rows.map((r) => {
    const href = realUrl(r.url);
    const ext = href?.startsWith('http');
    return (
      <li class="row">
        {r.type && <span class="type">{r.colour && <span class="sq" style={`background: var(--${r.colour})`} aria-hidden="true" />}{r.type}</span>}
        <span class="title">
          {href ? <a href={href} {...(ext ? { rel: 'noopener' } : {})}>{r.title}{ext && <span aria-hidden="true"> ↗</span>}</a> : r.title}
          {r.url && !href && <Txt text={r.url.startsWith('[') ? ` ${r.url.replace(']', ': link]')}` : ''} />}
        </span>
        {r.source && <span class="source"><Txt text={r.source} /></span>}
        {r.year && <span class="year"><Txt text={r.year} /></span>}
      </li>
    );
  })}
</ul>
<style>
  .rows { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .row {
    display: grid; grid-template-columns: 150px minmax(0, 1fr) minmax(0, 260px) 110px; gap: var(--s-1) var(--s-3);
    align-items: baseline; padding: var(--s-2) 0; border-bottom: 1px solid var(--line);
  }
  .type { display: inline-flex; align-items: center; gap: 8px; font: 600 11px/1.4 var(--sans); letter-spacing: .1em; text-transform: uppercase; color: var(--mute); }
  .sq { width: 10px; height: 10px; flex: none; }
  .title { font-weight: 500; }
  .title a { text-decoration: none; }
  .title a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .source { color: var(--mute); font-size: var(--fs-small); }
  .year { font: 400 13px/1.4 var(--mono); letter-spacing: .04em; text-align: right; color: var(--mute); }
  @media (max-width: 860px) {
    .row { grid-template-columns: minmax(0, 1fr) auto; }
    .type { grid-column: 1; }
    .year { grid-column: 2; grid-row: 1; }
    .title, .source { grid-column: 1 / -1; }
  }
</style>
