---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SubNav from '../../components/SubNav.astro';
import ListRows from '../../components/ListRows.astro';
import FactsStrip from '../../components/FactsStrip.astro';
import ToConfirm from '../../components/ToConfirm.astro';
import subnav from '../../data/subnav.json';
import media from '../../data/media.json';
import company from '../../data/company.json';
import about from '../../data/about.json';
const typeColour: Record<string, string> = { Press: 'royal', Interview: 'teal', Podcast: 'navy', Broadcast: 'navy', Talk: 'sky', 'Case study': 'teal', 'Partner blog': 'sky', Ranking: 'royal' };

// Press kit: logo files generated by scripts/brand.mjs into public/brand/.
const logos = [
  { name: 'Logo, dark on white', base: 'reef-support-logo', note: 'Mark and wordmark, horizontal, transparent background', preview: 'light' },
  { name: 'Logo, white on ink', base: 'reef-support-logo-white-on-ink', note: 'Mark and wordmark on an ink field', preview: 'dark' },
  { name: 'Mark', base: 'reef-support-mark', note: 'Ink square with three bars', preview: 'light' },
  { name: 'Mark, white', base: 'reef-support-mark-white', note: 'White square version for ink backgrounds', preview: 'dark' },
];
const swatches = [
  { token: 'ink', hex: '#0A1F33', use: 'Text, buttons, footer' },
  { token: 'white', hex: '#FFFFFF', use: 'Background' },
  { token: 'mist', hex: '#EAF2FA', use: 'Light panels' },
  { token: 'royal', hex: '#1458B8', use: '01 · Coral reef intelligence' },
  { token: 'navy', hex: '#0B3A6E', use: '02 · Mangroves and blue carbon' },
  { token: 'teal', hex: '#0A7EA4', use: '03 · Coastal water and earth observation' },
  { token: 'sky', hex: '#9CCBF2', use: '04 · Field programmes and open innovation' },
];
const words = (s: string) => s.trim().split(/\s+/).length;
const boilerplate = [
  { id: 'bp-short', label: 'Short description', text: company.shortDescription },
  { id: 'bp-long', label: 'Long description', text: about.longDescription },
];
const keyFacts = [
  { label: 'Legal name', value: company.legalName },
  { label: 'KvK', value: company.kvk },
  { label: 'Registered address', value: company.registeredAddress },
  { label: 'Working base', value: company.workingBase },
  { label: 'Founders', value: company.founders.join(' and ') },
  ...about.facts,
];
---
<Base title="Awards and media" description="Awards and press for Reef Support, including the ESA Copernicus Masters Overall Prize 2020, MT/Sprout 25 under 25, and coverage by TU Delft, Delta and ML6, plus a press kit with logos and descriptions.">
  <PageHeader kicker={['About', 'Media']} title="Awards and media" lead="Prizes for Reef Support and its founders, and coverage of our work in the press, podcasts and partner publications." />
  <SubNav label="About" links={subnav.about} />
  <section class="section" aria-labelledby="aw-h">
    <div class="container">
      <h2 id="aw-h" class="mb">Awards</h2>
      <ListRows rows={media.awards.map((a) => ({ type: 'Award', colour: 'royal', title: a.title, source: `${a.by} · ${a.to}`, year: a.year }))} />
    </div>
  </section>
  <section class="section rule-top" aria-labelledby="md-h">
    <div class="container">
      <h2 id="md-h" class="mb">Media</h2>
      <ListRows rows={media.media.map((m) => ({ type: m.type, colour: typeColour[m.type], title: m.title, source: m.outlet, year: m.year, url: m.url }))} />
      <p class="note">Some older coverage describes plans and early prototypes from 2020 and 2021. Our current capabilities are described on the <a href="/work">Work</a> pages.</p>
    </div>
  </section>

  <section class="section rule-top" id="press-kit" aria-labelledby="pk-h">
    <div class="container">
      <p class="kicker">Media · Press kit</p>
      <h2 id="pk-h">Press kit</h2>
      <p class="pk-lead">Logo files, colours, approved company descriptions and key facts for articles, event programmes and partner websites. Please use the files as supplied, on white or ink backgrounds, without recolouring, stretching or adding effects.</p>

      <h3 class="pk-h3" id="pk-logos">Logo files</h3>
      <ul class="logos" aria-labelledby="pk-logos">
        {logos.map((l) => (
          <li class="logo-cell">
            <div class:list={['logo-preview', `logo-preview--${l.preview}`]}>
              <img src={`/brand/${l.base}.svg`} alt="" width="240" height="64" loading="lazy" decoding="async" />
            </div>
            <div class="logo-body">
              <p class="logo-name">{l.name}</p>
              <p class="logo-note">{l.note}</p>
              <p class="logo-links meta">
                <a href={`/brand/${l.base}.svg`} download>SVG</a>
                <a href={`/brand/${l.base}-512.png`} download>PNG 512</a>
                <a href={`/brand/${l.base}-1024.png`} download>PNG 1024</a>
              </p>
            </div>
          </li>
        ))}
      </ul>
      <p class="small">The wordmark is set in Poppins 600. Colour values as data: <a href="/brand/colours.json" download>colours.json</a>.</p>

      <h3 class="pk-h3" id="pk-colours">Colours</h3>
      <ul class="swatches" aria-labelledby="pk-colours">
        {swatches.map((s) => (
          <li class="swatch">
            <span class="chip" style={`background:${s.hex}`} aria-hidden="true"></span>
            <span class="sw-name">{s.token}</span>
            <span class="sw-hex meta">{s.hex}</span>
            <span class="sw-use">{s.use}</span>
          </li>
        ))}
      </ul>

      <h3 class="pk-h3">Company descriptions</h3>
      <div class="boiler">
        {boilerplate.map((b) => (
          <figure class="bp">
            <figcaption class="bp-head">
              <span class="kicker bp-kicker">{b.label}</span>
              <span class="meta bp-count">{words(b.text)} words</span>
              <button type="button" class="copy-btn" data-copy={b.id} hidden>Copy<span class="visually-hidden"> {b.label.toLowerCase()}</span></button>
            </figcaption>
            <p id={b.id} class="bp-text">{b.text}</p>
          </figure>
        ))}
      </div>
      <p class="copy-status visually-hidden" role="status" aria-live="polite"></p>

      <h3 class="pk-h3">Key facts</h3>
      <FactsStrip items={keyFacts} />

      <h3 class="pk-h3">Press contact</h3>
      {import.meta.env.DEV && <p><ToConfirm note="press photos with photographer credit and permission (see docs/assets-brief.md)" /></p>}
      <p>For interviews, images or a fact check before publication, write to us through the contact page and mention your outlet and deadline.</p>
      <p><a class="btn btn--secondary" href="/contact">Contact the team <span class="arrow" aria-hidden="true">→</span></a></p>
    </div>
  </section>
</Base>
<script>
  const status = document.querySelector<HTMLElement>('.copy-status');
  if (navigator.clipboard) {
    document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
      btn.hidden = false;
      btn.addEventListener('click', async () => {
        const text = document.getElementById(btn.dataset.copy || '')?.textContent?.trim() ?? '';
        try {
          await navigator.clipboard.writeText(text);
          btn.firstChild!.textContent = 'Copied';
          if (status) status.textContent = 'Description copied to the clipboard.';
          setTimeout(() => { btn.firstChild!.textContent = 'Copy'; }, 2000);
        } catch {
          if (status) status.textContent = 'Copying failed. Select the text to copy it.';
        }
      });
    });
  }
</script>
<style>
  .mb { margin-bottom: var(--s-4); }
  .note { margin-top: var(--s-4); color: var(--mute); font-size: var(--fs-small); }
  .small { font-size: var(--fs-small); color: var(--mute); }
  .small a, .logo-links a { text-decoration: underline; text-underline-offset: 3px; }
  .pk-lead { margin-top: var(--s-2); color: var(--mute); }
  .pk-h3 { font-size: var(--fs-h3); margin: var(--s-6) 0 var(--s-3); padding-top: var(--s-2); border-top: 1px solid var(--ink); }

  .logos { list-style: none; margin: 0 0 var(--s-2); padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  @media (max-width: 960px) { .logos { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .logos { grid-template-columns: 1fr; } }
  .logo-cell { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); display: flex; flex-direction: column; }
  .logo-preview { height: 128px; display: flex; align-items: center; justify-content: center; padding: var(--s-3); border-bottom: 1px solid var(--line); }
  .logo-preview--light { background: var(--white); }
  .logo-preview--dark { background: var(--ink); }
  .logo-preview img { max-width: 100%; max-height: 56px; width: auto; height: auto; }
  .logo-body { padding: var(--s-2) var(--s-2) var(--s-3); }
  .logo-name { font-weight: 600; margin: 0 0 4px; }
  .logo-note { font-size: var(--fs-small); color: var(--mute); margin: 0 0 var(--s-2); }
  .logo-links { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-2); margin: 0; font-weight: 500; }

  .swatches { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(7, 1fr); gap: var(--gutter); }
  @media (max-width: 1024px) { .swatches { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 600px) { .swatches { grid-template-columns: repeat(2, 1fr); gap: var(--s-3) var(--s-2); } }
  .swatch { display: flex; flex-direction: column; gap: 2px; font-size: var(--fs-small); }
  .chip { display: block; aspect-ratio: 4 / 3; border: 1px solid var(--line); margin-bottom: var(--s-1); }
  .sw-name { font-weight: 600; }
  .sw-hex { color: var(--ink); }
  .sw-use { color: var(--mute); line-height: 1.4; }

  .boiler { display: grid; gap: var(--s-3); max-width: 880px; }
  .bp { margin: 0; border: 1px solid var(--line); }
  .bp-head { display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-1) var(--s-2); padding: var(--s-1) var(--s-2); border-bottom: 1px solid var(--line); background: var(--mist); }
  .bp-kicker { margin: 0; color: var(--mute-dark); }
  .bp-count { color: var(--mute-dark); }
  .copy-btn { margin-left: auto; background: var(--white); border: 1px solid var(--ink); padding: 4px 12px; font: 600 13px/1.4 var(--sans); cursor: pointer; transition: background-color 150ms, color 150ms; }
  .copy-btn:hover { background: var(--ink); color: var(--white); }
  .bp-text { margin: 0; padding: var(--s-2) var(--s-2) var(--s-3); max-width: none; }
</style>
