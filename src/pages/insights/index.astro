---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CardGrid from '../../components/CardGrid.astro';
import InsightCard from '../../components/InsightCard.astro';
import ToConfirm from '../../components/ToConfirm.astro';
import Newsletter from '../../components/Newsletter.astro';
import company from '../../data/company.json';
import { getAreas, getInsights } from '../../lib/data';
const posts = await getInsights();
const areas = await getAreas();
const areaById = Object.fromEntries(areas.map((a) => [a.id, a]));
const linkedin = company.social.find((s) => s.label === 'LinkedIn')!.url;
const lead = 'Field notes from our projects, news and events.';
---
<Base title="Insights" description="Field notes and news from Reef Support's work on coral reefs, mangroves and coastal waters, from the Coral Lab in Lombok to open AI challenges and events.">
  <PageHeader kicker={['Insights']} title="Field notes and news" lead={lead} display />
  <section class="section">
    <div class="container">
      {posts.length > 0 ? (
        <CardGrid>{posts.map((p) => <InsightCard post={p} area={p.data.area ? areaById[p.data.area] : undefined} headingLevel="h2" />)}</CardGrid>
      ) : (
        <div class="empty">
          <ToConfirm note="migrate posts from the previous site (CONTENT.md section 7)" />
          <p>Field notes from the previous site are being moved here. Until then, project updates are posted on <a href={linkedin} rel="noopener">LinkedIn</a>.</p>
        </div>
      )}
    </div>
  </section>
  <Newsletter />
</Base>
<style>
  .empty { border-top: 2px solid var(--ink); padding-top: var(--s-3); }
  .empty a { font-weight: 600; }
</style>
