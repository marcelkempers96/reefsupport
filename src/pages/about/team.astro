---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SubNav from '../../components/SubNav.astro';
import PersonCard from '../../components/PersonCard.astro';
import CardGrid from '../../components/CardGrid.astro';
import Txt from '../../components/Txt.astro';
import ToConfirm from '../../components/ToConfirm.astro';
import Summary from '../../components/readability/Summary.astro';
import subnav from '../../data/subnav.json';
import data from '../../data/team.json';
import { isDev, stripConfirm } from '../../lib/confirm';
const lead = "Three people lead Reef Support's work, with partners and students across each project.";
const alumni = data.alumni.filter((a) => a.consent);
---
<Base title="Team" description="Reef Support's team: co-founders Marcel Kempers (Director) and Yohan Runhaar (Technical Lead), and Nikole Gualdron Chaparro, Director of Marine Science.">
  <PageHeader kicker={['About', 'Team']} title="Team" lead={lead} />
  <SubNav label="About" links={subnav.about} />
  <section class="section section--tight">
    <div class="container">
      <Summary id="sum-h" label="Who leads what">
        <p>Marcel Kempers, co-founder and Director, leads partnerships, funding and projects. Yohan Runhaar, co-founder and Technical Lead, leads the AI models, data engineering and software. Nikole Gualdron Chaparro, Director of Marine Science, leads monitoring design and ecological indicators and reviews every marine science claim before it is published or submitted.</p>
      </Summary>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2 class="visually-hidden">Team members</h2>
      <CardGrid>
        {data.team.map((p) => <PersonCard name={p.name} role={p.role} focus={p.focus} colour={p.colour} href={`#${p.slug}`} />)}
      </CardGrid>
    </div>
  </section>

  {data.team.map((p) => (
    <section class="section rule-top bio" id={p.slug} aria-labelledby={`${p.slug}-h`}>
      <div class="container split">
        <div class="bio__mark" aria-hidden="true"><span style={`background: var(--${p.colour})`}></span></div>
        <div class="split__main bio__text">
          <p class="kicker">{p.role}</p>
          <h2 id={`${p.slug}-h`}>{p.name}</h2>
          <p class="focus">{p.focus}</p>
          <p><Txt text={isDev ? p.bio : stripConfirm(p.bio)} /></p>
          {p.links.length > 0 && <p>{p.links.map((l) => <a class="text-link" href={l.url} rel="noopener">{l.label}</a>)}</p>}
        </div>
      </div>
    </section>
  ))}

  {alumni.length > 0 && (
    <section class="section rule-top" aria-labelledby="al-h">
      <div class="container">
        <h2 id="al-h">Alumni and past contributors</h2>
        <ul>{alumni.map((a) => <li>{a.name}, {a.context}</li>)}</ul>
      </div>
    </section>
  )}
  {isDev && alumni.length === 0 && <div class="container"><p><ToConfirm note="alumni hidden until consent: true is set per person" /></p></div>}
</Base>
<style>
  .bio__mark { grid-column: 1 / span 3; padding-top: 6px; }
  .bio__mark span { display: block; width: 48px; height: 4px; }
  .bio__text { grid-column: 4 / span 8; }
  .bar { height: var(--bar); }
  .bio h2 { margin-bottom: var(--s-1); }
  .focus { color: var(--mute); font-weight: 500; }
  @media (max-width: 960px) { .bio__mark, .bio__text { grid-column: 1 / -1; } }
</style>
