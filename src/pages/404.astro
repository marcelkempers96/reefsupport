---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist." noindex>
  <section class="section">
    <div class="container">
      <p class="kicker">404</p>
      <h1 class="display">Page not found</h1>
      <p class="lead">This page has moved or no longer exists. Most older pages now redirect to their new location; if you followed a link here, try one of these.</p>
      <ul class="links">
        <li><a href="/">Home</a></li>
        <li><a href="/work">Work</a></li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/research">Research</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
  </section>
</Base>
<style>
  .display { font-size: var(--fs-display); font-weight: 800; line-height: 1.05; letter-spacing: -0.025em; margin-bottom: var(--s-3); }
  .links { list-style: none; padding: 0; margin: var(--s-4) 0 0; display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-3); }
  .links a { font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
</style>
