---
import Base from '../layouts/Base.astro';
import nav from '../data/nav.json';
import areas from '../data/areas.json';

const sections = [
  { label: 'Work', href: '/work', desc: 'Our four practice areas: coral reefs, mangroves, coastal water and field programmes.' },
  { label: 'Services', href: '/services', desc: 'Monitoring design, data integration, AI analysis and reporting you can bring us in for.' },
  { label: 'Projects', href: '/projects', desc: 'Case studies from Indonesia, Colombia and the Netherlands.' },
  { label: 'Research', href: '/research', desc: 'Coral AI, publications, hackathons and the methods we follow.' },
  { label: 'Insights', href: '/insights', desc: 'Field notes and news from our projects and partners.' },
  { label: 'About', href: '/about', desc: 'The company, team, partners, awards and policies.' },
];
const legal = nav.legal;
---
<Base title="Page not found" description="This page does not exist." noindex>
  <section class="section">
    <div class="container">
      <p class="kicker">Error 404</p>
      <h1 class="display">Page not found</h1>
      <p class="lead">This page has moved or no longer exists. Most older pages, including the former blog, now redirect to their new location, so if you followed a link here, search the site or pick a section below.</p>

      <form class="search" action="/search" method="get" role="search" aria-label="Search the site" data-404-search>
        <label for="q404" class="search__label">Search reef.support</label>
        <div class="search__row">
          <input id="q404" name="q" type="search" autocomplete="off" placeholder="For example Coral AI, mangroves or Lombok" />
          <button class="btn" type="submit">Search</button>
        </div>
      </form>
    </div>
  </section>

  <section class="section section--tight rule" aria-labelledby="sections-h">
    <div class="container">
      <h2 id="sections-h" class="h">Main sections</h2>
      <ul class="sections">
        {sections.map((s) => (
          <li>
            <a href={s.href}>
              <span class="sections__title">{s.label}<span aria-hidden="true"> →</span></span>
              <span class="sections__desc">{s.desc}</span>
            </a>
          </li>
        ))}
      </ul>

      <h2 class="h h--small">Practice areas</h2>
      <ul class="areas">
        {areas.map((a) => (
          <li><a href={`/work/${a.id}`}><span class="sq" style={`background: var(--${a.colour})`} aria-hidden="true" />{a.name}</a></li>
        ))}
      </ul>

      <p class="help">Still looking for something? <a href="/contact">Contact us</a> and tell us which page you expected to find, or go back to the <a href="/">home page</a>. Legal pages: {legal.map((l, i) => <>{i > 0 && ' · '}<a href={l.href}>{l.label}</a></>)}.</p>
    </div>
  </section>
</Base>

<script>
  // Prefill the search box with words from the missing URL, e.g. /blogs/coral-lab-part-1 -> "coral lab part 1".
  const input = document.querySelector<HTMLInputElement>('[data-404-search] input[name="q"]');
  if (input && !input.value) {
    const words = decodeURIComponent(location.pathname)
      .split('/').filter(Boolean).pop()
      ?.replace(/\.[a-z]+$/i, '').replace(/[-_]+/g, ' ').trim();
    if (words && words.length > 2 && words.length < 60) input.value = words;
  }
</script>

<style>
  .display { font-size: var(--fs-display); font-weight: 800; line-height: 1.05; letter-spacing: -0.025em; margin-bottom: var(--s-3); }
  .search { margin-top: var(--s-5); max-width: var(--measure); }
  .search__label { display: block; font: 600 15px/1.4 var(--sans); margin-bottom: var(--s-1); }
  .search__row { display: flex; gap: var(--s-1); }
  .search input {
    flex: 1; min-width: 0; padding: 12px 14px; font: 400 16px/1.2 var(--sans); color: var(--ink);
    background: var(--white); border: 1px solid var(--mute);
  }
  .search input::placeholder { color: var(--mute); }
  .search input:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

  .rule { border-top: 1px solid var(--line); }
  .h { margin-bottom: var(--s-3); }
  .h--small { font-size: var(--fs-h3); margin-top: var(--s-5); margin-bottom: var(--s-2); }
  .sections {
    list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr);
    border-top: 2px solid var(--ink);
  }
  .sections li { border-bottom: 1px solid var(--line); }
  .sections a { display: block; height: 100%; padding: var(--s-3) var(--s-3) var(--s-3) 0; text-decoration: none; }
  .sections__title { display: block; font: 600 var(--fs-h3)/1.3 var(--sans); }
  .sections a:hover .sections__title { text-decoration: underline; text-underline-offset: 4px; }
  .sections__desc { display: block; margin-top: 4px; font-size: var(--fs-small); line-height: 1.5; color: var(--mute); }
  .sections a:hover .sections__desc { color: var(--mute); }
  .areas { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-4); }
  .areas a { display: inline-flex; align-items: center; gap: 10px; font-weight: 500; text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 4px; }
  .areas a:hover { text-decoration-color: currentColor; }
  .sq { width: 12px; height: 12px; flex: none; }
  .help { margin-top: var(--s-5); }
  .help a { font-weight: 600; }
  @media (max-width: 860px) { .sections { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .sections { grid-template-columns: 1fr; } }
</style>
