---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SubNav from '../../components/SubNav.astro';
import ToConfirm from '../../components/ToConfirm.astro';
import subnav from '../../data/subnav.json';
// Policy texts are an open item (CLAUDE.md). Each becomes a short dated page signed by the Director.
const policies = [
  'Data protection (GDPR)',
  'Research data management and open data',
  'Safeguarding and code of conduct',
  'Anti-fraud and anti-corruption',
  'Gender equality statement',
];
---
<Base title="Policies" description="Reef Support's policies on data protection, research data, safeguarding, anti-fraud and gender equality.">
  <PageHeader kicker={['About', 'Policies']} title="How we work responsibly" />
  <SubNav label="About" links={subnav.about} />
  <section class="section">
    <div class="container">
      <ul class="rows">
        {policies.map((p) => (
          <li><span class="title">{p}</span><ToConfirm note="policy text, date and Director signature" /></li>
        ))}
      </ul>
      <p class="note">Questions about any of these policies? <a href="/contact">Contact us</a>.</p>
    </div>
  </section>
</Base>
<style>
  .rows { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .rows li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-1) var(--s-3); padding: var(--s-2) 0; border-bottom: 1px solid var(--line); }
  .title { font-weight: 500; }
  .note { margin-top: var(--s-4); color: var(--mute); }
  .note a { color: var(--ink); font-weight: 600; }
</style>
