---
// Shared frame for the schematic practice-area visuals (DESIGN.md: flat, square, colour tokens
// only, never a fake photo). The slotted SVG plays a short one-off build-in (under 4 s) on load;
// prefers-reduced-motion shows the finished drawing straight away.
interface Props {
  caption: string;
  legend?: { label: string; c: string; outline?: boolean }[];
  class?: string;
}
const { caption, legend = [], class: cls } = Astro.props;
---
<figure class:list={['viz', cls]}>
  <div class="viz__art"><slot /></div>
  <figcaption class="viz__cap">
    {legend.length > 0 && (
      <ul class="viz__legend">
        {legend.map((l) => <li><span class:list={{ ol: l.outline }} style={`--k: ${l.c}`} aria-hidden="true"></span>{l.label}</li>)}
      </ul>
    )}
    <p><span class="meta viz__tag">Schematic illustration</span> {caption}</p>
  </figcaption>
</figure>

<style is:global>
  .viz { margin: var(--s-5) 0 0; max-width: 640px; border: 1px solid var(--line); background: var(--white); }
  .viz__art svg { display: block; width: 100%; height: auto; }
  .viz__art text { font-family: var(--sans); font-weight: 600; font-size: 15px; fill: var(--ink); }
  .viz__art text.m { font-family: var(--mono); font-weight: 500; font-size: 12px; letter-spacing: .04em; fill: var(--mute); }
  .viz__cap { padding: var(--s-2); border-top: 1px solid var(--line); font-size: var(--fs-small); color: var(--mute-dark); }
  .viz__cap p { margin: 0; max-width: var(--measure); }
  .viz__tag { display: inline-block; color: var(--mute); margin-right: 4px; text-transform: uppercase; }
  .viz__legend { list-style: none; margin: 0 0 var(--s-1); padding: 0; display: flex; flex-wrap: wrap; gap: 6px 16px; color: var(--ink); }
  .viz__legend li { display: inline-flex; align-items: center; gap: 8px; }
  .viz__legend span { width: 12px; height: 12px; background: var(--k); border: 1px solid rgba(10, 31, 51, .15); }
  .viz__legend span.ol { background: transparent; border: 2px solid var(--k); }

  /* One-off build-in. Opacity only, so SVG transform attributes stay intact. */
  .viz .va { animation: viz-in .5s ease both; animation-delay: calc(var(--i, 0) * 110ms + 150ms); }
  .viz .vd { stroke-dasharray: 1; animation: viz-draw 1.1s ease both; animation-delay: calc(var(--i, 0) * 110ms + 150ms); }
  @keyframes viz-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes viz-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .viz .va, .viz .vd { animation: none; } }
</style>
