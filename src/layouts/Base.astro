---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  searchable?: boolean;
}
const { searchable = true, ...props } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <SEO {...props} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1" {...(searchable && !props.noindex ? { 'data-pagefind-body': '' } : {})}>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/forms.ts';
    </script>
  </body>
</html>
