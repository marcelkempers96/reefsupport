---
import type { Area } from '../lib/data';
interface Props { area: Area; headingLevel?: 'h2' | 'h3' }
const { area, headingLevel = 'h3' } = Astro.props;
const { no, name, colour, tile } = area.data;
const H = headingLevel;
---
<a href={`/work/${area.id}`} class:list={['tile', `tile--${colour}`]}>
  <p class="tile__kicker">{no} · Practice area</p>
  <H class="tile__name">{name}</H>
  <p class="tile__text">{tile}</p>
  <span class="tile__arrow" aria-hidden="true">→</span>
</a>
<style>
  .tile {
    position: relative; display: flex; flex-direction: column; min-height: 240px; padding: var(--s-4);
    text-decoration: none; color: var(--white); transition: filter 150ms;
  }
  .tile:hover { color: var(--white); filter: brightness(1.08); }
  .tile--royal { background: var(--royal); }
  .tile--navy { background: var(--navy); }
  .tile--teal { background: var(--teal); }
  .tile--sky { background: var(--sky); color: var(--ink); }
  .tile--sky:hover { color: var(--ink); filter: brightness(1.04); }
  .tile__kicker { font: 600 var(--fs-kicker)/1.4 var(--sans); letter-spacing: .1em; text-transform: uppercase; margin: 0 0 var(--s-2); }
  .tile__name { font-size: var(--fs-h3); font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; }
  .tile__text { margin: auto 0 0; padding-top: var(--s-3); padding-right: var(--s-4); font-size: var(--fs-small); line-height: 1.5; }
  .tile__arrow { position: absolute; right: var(--s-4); bottom: var(--s-4); font-weight: 600; transition: transform 150ms; }
  .tile:hover .tile__arrow { transform: translateX(4px); }
</style>
