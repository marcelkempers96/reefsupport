---
// Layout for legal and policy pages: page header, "Last updated" line, optional
// "On this page" list of anchors (side column on wide screens, above the text on narrow ones).
// Until a publication date is confirmed the date shows as a dev-only [TO CONFIRM] marker.
import Base from './Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ToConfirm from '../components/ToConfirm.astro';
interface Props {
  title: string;
  description: string;
  /** Publication or revision date, e.g. "12 January 2027". */
  updated?: string;
  /** Anchors for the "On this page" list; ids must match headings in the slot. */
  toc?: { id: string; label: string }[];
  kicker?: string[];
  heading?: string;
  lead?: string;
}
const { title, description, updated, toc = [], kicker = ['Legal'], heading, lead } = Astro.props;
---
<Base title={title} description={description}>
  <PageHeader kicker={kicker} title={heading ?? title} lead={lead} />
  <slot name="subnav" />
  <section class="section">
    <div class="container" class:list={['legal', { 'legal--toc': toc.length > 0 }]}>
      <div class="legal__main">
        <p class="meta upd">
          {updated ? <>Last updated <time>{updated}</time></> : <ToConfirm note="last updated: legal review and publication date" />}
        </p>
        <div class="prose"><slot /></div>
      </div>
      {toc.length > 0 && (
        <nav class="legal__toc" aria-labelledby="toc-h">
          <h2 id="toc-h" class="toc__h">On this page</h2>
          <ol>
            {toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
          </ol>
        </nav>
      )}
    </div>
  </section>
</Base>
<style>
  .upd { color: var(--mute); margin-bottom: var(--s-4); }
  .upd:empty { display: none; }
  .legal--toc { display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--s-5) var(--gutter); align-items: start; }
  .legal__main { grid-column: 1 / span 8; min-width: 0; }
  .legal__toc { grid-column: 10 / span 3; position: sticky; top: calc(var(--header-h, 72px) + var(--s-3)); border-top: 1px solid var(--ink); padding-top: var(--s-2); }
  .toc__h { font: 600 var(--fs-kicker, 12px)/1.4 var(--sans); letter-spacing: .1em; text-transform: uppercase; color: var(--mute); margin: 0 0 var(--s-1); }
  .legal__toc ol { list-style: none; margin: 0; padding: 0; counter-reset: toc; }
  .legal__toc li { counter-increment: toc; border-bottom: 1px solid var(--line-soft); }
  .legal__toc a { display: flex; gap: 12px; padding: 8px 0; font-size: var(--fs-small, 14px); line-height: 1.4; text-decoration: none; color: var(--ink); }
  .legal__toc a::before { content: counter(toc, decimal-leading-zero); font: 400 12px/1.6 var(--mono); color: var(--mute); flex: none; }
  .legal__toc a:hover { color: var(--teal); }
  .legal :global(.prose > h2:first-child) { margin-top: 0; }
  .legal :global(.prose .data-table) { margin: 0 0 var(--s-3); font-size: var(--fs-small, 14px); }
  .legal :global(.prose .table-wrap) { max-width: 100%; overflow-x: auto; }
  .legal :global(.prose dl) { margin: 0 0 var(--s-3); border-top: 1px solid var(--line); }
  .legal :global(.prose dl > div) { display: grid; grid-template-columns: 11em 1fr; gap: 4px var(--s-2); padding: 10px 0; border-bottom: 1px solid var(--line-soft); }
  .legal :global(.prose dt) { font-weight: 600; }
  .legal :global(.prose dd) { margin: 0; }
  @media (max-width: 600px) { .legal :global(.prose dl > div) { grid-template-columns: 1fr; } }
  @media (max-width: 960px) {
    .legal__main, .legal__toc { grid-column: 1 / -1; }
    .legal__toc { position: static; grid-row: 1; }
  }
</style>
