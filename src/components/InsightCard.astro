---
import { formatDate, type Insight, type Area } from '../lib/data';
interface Props { post: Insight; area?: Area; headingLevel?: 'h2' | 'h3' }
const { post, area, headingLevel = 'h3' } = Astro.props;
const d = post.data;
const H = headingLevel;
---
<article class="post">
  <div class="bar" style={`background: ${area ? `var(--${area.data.colour})` : 'var(--ink)'}`}></div>
  <div class="body">
    <p class="kicker">{[d.type, area?.data.name].filter(Boolean).join(' · ')}</p>
    <H class="title"><a href={`/insights/${post.id}`}>{d.title}</a></H>
    <p class="summary">{d.summary}</p>
    <p class="meta date"><time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time> · {d.author}</p>
  </div>
</article>
<style>
  /* Five rows: bar, kicker, title, summary, meta. Subgrid inside a CardGrid aligns them across cards. */
  .post {
    position: relative; display: grid; grid-template-rows: auto auto auto 1fr auto;
    border: 1px solid var(--line); background: var(--white); transition: border-color 150ms;
  }
  @supports (grid-template-rows: subgrid) {
    .post { grid-row: span 5; grid-template-rows: subgrid; row-gap: 0; }
  }
  .post:hover, .post:focus-within { border-color: var(--ink); }
  .post:focus-within { outline: 2px solid var(--ink); outline-offset: 2px; }
  .bar { height: var(--bar); }
  .body { display: contents; }
  .body > * { padding-inline: var(--s-3); margin: 0; }
  .kicker { padding-top: var(--s-3); margin-bottom: var(--s-1); align-self: start; }
  .title { font-size: var(--fs-h3); line-height: 1.3; letter-spacing: -0.01em; padding-bottom: var(--s-1); }
  .title a {
    text-decoration: underline 2px transparent; text-underline-offset: 4px;
    transition: color 150ms, text-decoration-color 150ms;
  }
  .title a::after { content: ''; position: absolute; inset: 0; }
  .title a:focus-visible { outline: none; }
  .post:hover .title a, .title a:focus-visible { color: var(--teal); text-decoration-color: currentColor; }
  .summary { color: var(--mute); font-size: var(--fs-small); line-height: 1.5; max-width: none; padding-bottom: var(--s-3); }
  .date { color: var(--mute); padding-block: var(--s-2) var(--s-3); border-top: 1px solid var(--line-soft); margin-inline: var(--s-3); padding-inline: 0; }
</style>
