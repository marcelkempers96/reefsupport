{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/solutions",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/programs",
      "destination": "/work/field-programmes",
      "permanent": true
    },
    {
      "source": "/programs/coral-lab",
      "destination": "/projects/coral-lab-lombok",
      "permanent": true
    },
    {
      "source": "/programs/coral-lab/lombok",
      "destination": "/projects/coral-lab-lombok",
      "permanent": true
    },
    {
      "source": "/coral-lab",
      "destination": "/projects/coral-lab-lombok",
      "permanent": true
    },
    {
      "source": "/programs/hackathons",
      "destination": "/research/hackathons",
      "permanent": true
    },
    {
      "source": "/hackathon-sign-up",
      "destination": "/research/hackathons",
      "permanent": true
    },
    {
      "source": "/tools",
      "destination": "/research/open-source",
      "permanent": true
    },
    {
      "source": "/tools/3d",
      "destination": "/projects/photogrammetry-colombia",
      "permanent": true
    },
    {
      "source": "/mangroveai",
      "destination": "/projects/mangrove-ai",
      "permanent": true
    },
    {
      "source": "/algae-tracker",
      "destination": "/projects/algae-tracker",
      "permanent": true
    },
    {
      "source": "/global",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/why-reefs",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/partners-and-sponsors",
      "destination": "/about/partners",
      "permanent": true
    },
    {
      "source": "/press",
      "destination": "/about/media",
      "permanent": true
    },
    {
      "source": "/news/:path*",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/blogs/:slug",
      "destination": "/insights/:slug",
      "permanent": true
    },
    {
      "source": "/team",
      "destination": "/about/team",
      "permanent": true
    },
    {
      "source": "/jobs",
      "destination": "/about/opportunities",
      "permanent": true
    },
    {
      "source": "/play-your-part",
      "destination": "/about/opportunities",
      "permanent": true
    },
    {
      "source": "/students",
      "destination": "/work/field-programmes",
      "permanent": true
    },
    {
      "source": "/legal",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/reef-conservancy",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/ocean-data-types",
      "destination": "/research/methods",
      "permanent": true
    },
    {
      "source": "/data-labelling",
      "destination": "/research/open-source",
      "permanent": true
    },
    {
      "source": "/amba-stapert",
      "destination": "/projects/coral-lab-lombok",
      "permanent": true
    },
    {
      "source": "/adopt-a-coral",
      "destination": "https://indonesia-biru.com/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
