---
// Coral AI block for Research index and Open source pages.
// The figure is an animated, schematic segmentation demo: a scan line passes over a drawn reef
// scene, class masks appear region by region, then an "illustrative output" readout fills in.
// Without JS or under prefers-reduced-motion the final frame is shown as a static image.
interface Props { headingLevel?: 'h1' | 'h2' }
const { headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
const legend = [
  { label: 'Hard coral', c: 'var(--royal)' },
  { label: 'Soft coral', c: 'var(--teal)' },
  { label: 'Algae', c: 'var(--navy)' },
  { label: 'Sand and rubble', c: 'var(--mute)' },
];

// Mask regions in a 400 x 300 scene, drawn as jagged polygons like real segmentation output.
// `at` is the animation tick (400 ms each) at which the scan line has passed the region.
const rnd = (i: number, seed: number) => {
  const x = Math.sin(i * 12.9898 + seed * 78.233) * 43758.5453;
  return x - Math.floor(x);
};
const poly = (cx: number, cy: number, rx: number, ry: number, n: number, seed: number) => {
  const pts = Array.from({ length: n }, (_, i) => {
    const a = (i / n) * Math.PI * 2;
    const k = 0.72 + rnd(i, seed) * 0.4;
    return `${(cx + Math.cos(a) * rx * k).toFixed(1)} ${(cy + Math.sin(a) * ry * k).toFixed(1)}`;
  });
  return `M${pts.join(' L')}Z`;
};
const seabed = (() => {
  const pts = Array.from({ length: 21 }, (_, i) => `${i * 20} ${(204 + Math.sin(i * 0.9) * 10 + (rnd(i, 7) - 0.5) * 12).toFixed(1)}`);
  return `M${pts.join(' L')} L400 300 L0 300Z`;
})();
const regions = [
  { at: 4, cls: 'Sand and rubble', fill: 'var(--mute)', d: seabed, lx: 14, ly: 270 },
  { at: 5, cls: 'Hard coral', fill: 'var(--royal)', d: poly(90, 130, 62, 58, 26, 1), lx: 44, ly: 122 },
  { at: 8, cls: 'Soft coral', fill: 'var(--teal)', d: poly(180, 56, 24, 22, 16, 2), lx: 150, ly: 14 },
  { at: 9, cls: 'Algae', fill: 'var(--navy)', d: poly(205, 214, 52, 32, 22, 3), lx: 172, ly: 206 },
  { at: 12, cls: 'Soft coral', fill: 'var(--teal)', d: poly(275, 105, 58, 52, 24, 4), lx: 236, ly: 98 },
  { at: 14, cls: 'Hard coral', fill: 'var(--royal)', d: poly(335, 210, 36, 28, 18, 5), lx: 300, ly: 248 },
];
const chipW = (s: string) => Math.round(s.length * 5.9 + 12);

// Example values only, chosen to sum to 100. Not survey results.
const readout = [
  { label: 'Hard coral', v: 34, c: 'var(--royal)', at: 18 },
  { label: 'Soft coral', v: 18, c: 'var(--teal)', at: 19 },
  { label: 'Algae', v: 22, c: 'var(--navy)', at: 20 },
  { label: 'Sand and rubble', v: 26, c: 'var(--mute)', at: 21 },
];
---
<div class="coral split">
  <div class="split__main">
    <p class="kicker"><span class="sq" aria-hidden="true"></span>Open model · Coral reef intelligence</p>
    <H class:list={['title', { h1: headingLevel === 'h1' }]}>Coral AI</H>
    <p class="lead">A YOLOv8 segmentation model that labels reef photos by coral type, algae, rubble and sand, so cover estimates for transects come straight from survey images.</p>
    <p>It grew out of open challenges since 2021; the earlier GoogleNet classifier reached about 86% accuracy across six functional groups.</p>
    <div class="btn-row">
      <a class="btn" href="https://huggingface.co/reefsupport/coral-ai" rel="noopener">Model on Hugging Face</a>
      <a class="btn btn--secondary" href="https://github.com/reefsupport" rel="noopener">Code on GitHub</a>
    </div>
    <p class="note meta">MIT licence · Research and monitoring support with human review; not validated for regulatory reporting on its own.</p>
  </div>
  <figure class="split__side preview" data-coral>
    <div class="stage">
      <svg viewBox="0 0 400 300" role="img" aria-labelledby="seg-t seg-d">
        <title id="seg-t">Schematic Coral AI segmentation demo</title>
        <desc id="seg-d">A drawn reef scene is scanned from left to right and divided into hard coral, soft coral, algae, and sand and rubble regions, each with a label.</desc>
        <defs>
          <pattern id="coral-grid" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M20 0 H0 V20" fill="none" stroke="var(--line-soft)" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="400" height="300" fill="var(--white)" />
        <rect width="400" height="300" fill="url(#coral-grid)" />
        <g class="ticks" stroke="var(--mute)" stroke-width="1">
          {Array.from({ length: 9 }, (_, i) => <line x1={i * 50} y1="0" x2={i * 50} y2="5" />)}
          {Array.from({ length: 7 }, (_, i) => <line x1="0" y1={i * 50} x2="5" y2={i * 50} />)}
        </g>
        <g class="outline" fill="none" stroke="var(--mute)" stroke-opacity=".45" stroke-dasharray="3 3">
          {regions.map((r) => <path d={r.d} />)}
        </g>
        {regions.map((r) => (
          <g class="seg" data-at={r.at}>
            <path d={r.d} fill={r.fill} fill-opacity=".18" stroke={r.fill} stroke-width="1" stroke-linejoin="miter" />
            <g class="chip" transform={`translate(${r.lx} ${r.ly})`}>
              <rect width={chipW(r.cls)} height="16" fill="var(--white)" stroke={r.fill} stroke-width="1" />
              <text x="6" y="11.5" fill="var(--ink)">{r.cls}</text>
            </g>
          </g>
        ))}
        <g class="scan" aria-hidden="true">
          <rect x="-0.5" y="0" width="1" height="300" fill="var(--royal)" />
          <rect x="0" y="0" width="34" height="14" fill="var(--royal)" />
          <text x="4" y="10.5" class="scan__t" fill="var(--white)">SCAN</text>
        </g>
      </svg>
    </div>
    <figcaption>
      <ul class="legend">
        {legend.map((l) => <li><span style={`background: ${l.c}`} aria-hidden="true"></span>{l.label}</li>)}
      </ul>
      <div class="readout">
        <div class="readout__top">
          <p class="readout__h"><strong>Cover by class</strong> <span class="meta">Illustrative output · example values, not survey results</span></p>
          <button class="toggle" type="button" data-coral-toggle hidden>Pause animation</button>
        </div>
        <ul>
          {readout.map((r) => (
            <li>
              <span class="readout__l">{r.label}</span>
              <span class="track" aria-hidden="true"><span class="fill" data-at={r.at} style={`width: ${r.v}%; background: ${r.c}`}></span></span>
              <span class="meta readout__v" data-at={r.at}>{r.v}%</span>
            </li>
          ))}
        </ul>
      </div>
      <p class="meta cap">Schematic illustration, not a model output. <a href="https://reefsupport-coral-ai-demo.hf.space" rel="noopener">Try the public demo</a> with your own image.</p>
    </figcaption>
  </figure>
</div>

<script>
  // One timeline per figure: ticks of 400 ms, 38 ticks per loop (about 15 s).
  // Paused by the button, when the figure is off-screen, and never started under reduced motion.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-coral]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement | SVGElement>('[data-at]')];
    const btn = root.querySelector<HTMLButtonElement>('[data-coral-toggle]');
    let t = 0, timer = 0, userPaused = false, visible = false;
    const step = () => {
      const live = t > 0 && t < 34;
      root.classList.toggle('go', live);
      for (const el of items) el.classList.toggle('on', live && t >= Number(el.dataset.at));
      t = (t + 1) % 38;
    };
    const sync = () => {
      const anim = !reduce.matches;
      const running = anim && visible && !userPaused;
      root.classList.toggle('is-anim', anim);
      root.classList.toggle('is-paused', !running);
      if (btn) {
        btn.hidden = !anim;
        btn.textContent = userPaused ? 'Play animation' : 'Pause animation';
      }
      clearInterval(timer);
      if (running) timer = window.setInterval(step, 400);
    };
    btn?.addEventListener('click', () => { userPaused = !userPaused; sync(); });
    reduce.addEventListener('change', sync);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }, { threshold: 0.2 }).observe(root);
    sync();
  });
</script>

<style>
  .sq { width: 12px; height: 12px; background: var(--royal); }
  .title { font-size: var(--fs-h1); margin-bottom: var(--s-3); }
  .title.h1 { font-size: var(--fs-display); font-weight: var(--w-display); line-height: 1.05; letter-spacing: var(--ls-display); }
  .lead { margin-bottom: var(--s-2); }
  .btn-row { margin: var(--s-4) 0 var(--s-3); }
  .note { color: var(--mute); }
  .preview { margin: 0; border: 1px solid var(--line); }
  .stage { position: relative; }
  .preview svg { display: block; width: 100%; height: auto; }
  .preview text { font: 400 9.5px/1 var(--mono); letter-spacing: .02em; }
  .preview .scan__t { font: 500 10px/1 var(--mono); letter-spacing: .08em; }
  figcaption { padding: var(--s-2); border-top: 1px solid var(--line); }
  .legend { list-style: none; margin: 0 0 var(--s-2); padding: 0; display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: var(--fs-small); }
  .legend li { display: inline-flex; align-items: center; gap: 8px; }
  .legend span { width: 10px; height: 10px; }
  .cap { margin: 0; color: var(--mute); }

  .readout__top { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--s-1) var(--s-2); margin-bottom: var(--s-1); }
  .toggle {
    flex: none; padding: 6px 10px; min-height: 32px;
    background: var(--white); color: var(--ink); border: 1px solid var(--ink);
    font: 600 12px/1 var(--sans); cursor: pointer;
  }
  .toggle:hover { background: var(--ink); color: var(--white); }

  .readout { border-top: 1px solid var(--line-soft); padding-top: var(--s-2); margin-bottom: var(--s-2); }
  .readout__h { margin: 0; font-size: var(--fs-small); display: flex; flex-wrap: wrap; gap: 2px 8px; align-items: baseline; }
  .readout__h .meta { color: var(--mute); }
  .readout ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .readout li { display: grid; grid-template-columns: 8.5em 1fr 3.2em; gap: 8px; align-items: center; font-size: var(--fs-small); }
  .track { height: 6px; background: var(--line-soft); }
  .fill { display: block; height: 100%; transform-origin: left; }
  .readout__v { text-align: right; font-variant-numeric: tabular-nums; }

  /* Animated state: only applied by the script, so no-JS and reduced motion keep the final frame. */
  .scan { opacity: 0; }
  .is-anim .seg, .is-anim .fill, .is-anim .readout__v { transition: opacity .6s ease, transform .9s ease; }
  .is-anim .seg:not(.on), .is-anim .readout__v:not(.on) { opacity: 0; }
  .is-anim .fill:not(.on) { transform: scaleX(0); }
  .is-anim.go .scan { animation: coral-scan 6s linear forwards; }
  .is-paused .scan { animation-play-state: paused; }
  @keyframes coral-scan {
    0% { opacity: 1; transform: translateX(0); }
    96% { opacity: 1; }
    100% { opacity: 0; transform: translateX(400px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .scan { display: none; }
    .toggle { display: none; }
  }
  @media (min-width: 961px) { .split__side { grid-column: 8 / span 5; } }
</style>
