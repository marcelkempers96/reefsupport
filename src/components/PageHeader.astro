---
import Kicker from './Kicker.astro';
import Breadcrumbs from './Breadcrumbs.astro';
// Breadcrumbs render automatically for pages two or more levels deep (e.g. /work/coral-reefs).
interface Props { kicker: string[]; title: string; lead?: string; colour?: string; display?: boolean; breadcrumbs?: boolean }
const { kicker, title, lead, colour, display = false, breadcrumbs = true } = Astro.props;
---
<header class="page-header">
  <div class="container">
    {breadcrumbs && <Breadcrumbs current={title} />}
    <slot name="before" />
    <Kicker parts={kicker} colour={colour} />
    <h1 class:list={{ display }}>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>
<style>
  .page-header { padding: var(--s-6) 0 var(--s-5); border-bottom: 1px solid var(--line); }
  h1 { max-width: 920px; }
  h1.display { font-size: var(--fs-display); font-weight: var(--w-display); line-height: 1.05; letter-spacing: var(--ls-display); }
  .lead { margin-top: var(--s-3); margin-bottom: 0; }
</style>
