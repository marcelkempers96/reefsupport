---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SubNav from '../../components/SubNav.astro';
import CoralAI from '../../components/CoralAI.astro';
import ListRows from '../../components/ListRows.astro';
import Summary from '../../components/readability/Summary.astro';
import subnav from '../../data/subnav.json';
import research from '../../data/research.json';
import { liveUrl } from '../../lib/data';
const hacks = await Promise.all(research.hackathons.map(async (h) => ({ ...h, url: await liveUrl(h.url) })));
import partners from '../../data/partners.json';
const lead = 'We publish what we can, so others can test, reuse and improve it.';
const cards = [
  { title: 'Open source', text: 'Coral AI on Hugging Face, with code on GitHub.', href: '/research/open-source' },
  { title: 'Publications', text: 'Models, papers and theses from our work and our students.', href: '/research/publications' },
  { title: 'Hackathons', text: 'Six open AI challenges since 2021 with FruitPunch AI, OceanHub Africa, Zindi and others.', href: '/research/hackathons' },
  { title: 'Methods', text: 'The chain from field data to a report a funder can check, and who is responsible for each step.', href: '/research/methods' },
];
---
<Base title="Research" description="Open models, publications and AI challenges from Reef Support, including Coral AI on Hugging Face, so others can test, reuse and improve our coral reef work.">
  <PageHeader kicker={['Research']} title="Open models, publications and challenges" lead={lead} display />
  <SubNav label="Research" links={subnav.research} />
  <section class="section section--tight">
    <div class="container">
      <Summary id="sum-h" label="Summary">
        <p>Our research output is an open coral segmentation model on Hugging Face, papers and theses from our team and students, six open AI challenges since 2021, and a documented seven-step method that shows who is responsible for each part of a monitoring programme.</p>
      </Summary>
    </div>
  </section>

  <section class="section">
    <div class="container"><CoralAI /></div>
  </section>

  <section class="section rule-top" aria-label="Research sections">
    <div class="container">
      <ul class="links">
        {cards.map((c) => (
          <li><a href={c.href}><h2>{c.title}</h2><p>{c.text}</p><span aria-hidden="true">→</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section rule-top" aria-labelledby="recent-h">
    <div class="container">
      <div class="section-head"><h2 id="recent-h">Recent challenges</h2><a class="text-link" href="/research/hackathons">All hackathons</a></div>
      <ListRows rows={hacks.slice(0, 3).map((h) => ({ type: 'Challenge', colour: 'sky', title: h.title, source: h.partners, year: h.date, url: h.url }))} />
      <p class="infra"><strong>Infrastructure and data:</strong> {partners.infrastructureAndData.join(' · ')}</p>
    </div>
  </section>
</Base>
<style>
  .links { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--gutter); }
  .links a { position: relative; display: flex; flex-direction: column; height: 100%; padding: var(--s-3); border: 1px solid var(--line); text-decoration: none; }
  .links a:hover { border-color: var(--ink); color: var(--ink); }
  .links h2 { font-size: var(--fs-h3); font-weight: 600; margin-bottom: var(--s-1); }
  .links p { color: var(--mute); font-size: var(--fs-small); line-height: 1.5; margin-bottom: var(--s-3); }
  .links span { margin-top: auto; font-weight: 600; }
  @media (max-width: 1024px) { .links { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .links { grid-template-columns: 1fr; } }
  .infra { margin-top: var(--s-4); color: var(--mute); font-size: var(--fs-small); max-width: none; }
  .infra strong { color: var(--ink); }
</style>
