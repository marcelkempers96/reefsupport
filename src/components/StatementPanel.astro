---
import Kicker from './Kicker.astro';
interface Props { kicker: string; statement: string; link?: { label: string; href: string } }
const { kicker, statement, link } = Astro.props;
---
<div class="statement">
  <Kicker parts={[kicker]} />
  <p class="text">{statement}</p>
  {link && <a class="link" href={link.href}>{link.label} <span aria-hidden="true">→</span></a>}
</div>
<style>
  .statement { background: var(--mist); border-top: 4px solid var(--ink); padding: var(--s-5) var(--s-5) var(--s-5); }
  .statement :global(.kicker) { color: var(--mute-dark); }
  .text { font: 700 clamp(22px, 2.8vw, 34px)/1.25 var(--sans); letter-spacing: -0.02em; max-width: 900px; color: var(--ink); text-wrap: balance; }
  .link { font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  @media (max-width: 600px) { .statement { padding: var(--s-4) var(--s-3); } }
</style>
