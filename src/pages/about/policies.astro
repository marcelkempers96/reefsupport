---
// Short policy statements. Simple versions approved for publication by the owner; each can be
// replaced by a fuller signed text later without changing the page structure.
import Legal from '../../layouts/Legal.astro';
import SubNav from '../../components/SubNav.astro';
import subnav from '../../data/subnav.json';
import company from '../../data/company.json';

interface Policy { id: string; name: string; points: string[] }
const policies: Policy[] = [
  {
    id: 'data-protection',
    name: 'Data protection (GDPR)',
    points: [
      'We collect only the personal data we need for a stated purpose, use it only for that purpose and delete it when it is no longer needed.',
      'Personal data is stored with providers that offer GDPR safeguards, and access is limited to the people who need it.',
      'In partner projects we agree in writing who is the controller and who is the processor before personal data is shared.',
      'A suspected data breach is assessed straight away and reported to the Autoriteit Persoonsgegevens and the people affected where the law requires it.',
      'How this website handles personal data is set out in the privacy policy.',
    ],
  },
  {
    id: 'research-data',
    name: 'Research data management and open data',
    points: [
      'Survey images, 3D image sets, field records and partner data are documented with their source, date, site and licence when they enter a project.',
      'Data received from partners stays theirs and is used only as the project agreement allows.',
      'Where a project allows it, we publish models, code and methods openly, as with Coral AI under an MIT licence.',
      'Project data is stored securely with backups and kept for as long as the project agreement or funder requires.',
    ],
  },
  {
    id: 'safeguarding',
    name: 'Safeguarding and code of conduct',
    points: [
      'Everyone who represents Reef Support treats colleagues, partners and community members with respect, in the field, at partner sites and online.',
      'Field work follows the lead of local partners, respects local customs and rules, and takes place only with the consent of the communities involved.',
      'Harassment, discrimination, exploitation and abuse are not tolerated, and any contact with children or vulnerable adults happens only in the presence of the local partner.',
      'Concerns can be raised in confidence with the Director, and anyone who raises a concern in good faith is protected.',
    ],
  },
  {
    id: 'anti-fraud',
    name: 'Anti-fraud and anti-corruption',
    points: [
      'Grant and project funds are used only for the purposes agreed with the funder, and every payment is recorded and supported by documents.',
      'We do not offer, pay, ask for or accept bribes, and gifts or hospitality beyond a modest value are declined.',
      'Conflicts of interest are declared before decisions are made.',
      'Suspected fraud or corruption is investigated, reported to the funder concerned and, where needed, to the authorities.',
    ],
  },
  {
    id: 'gender-equality',
    name: 'Gender equality statement',
    points: [
      'We recruit staff, students and interns on merit, and aim for balanced teams and panels.',
      'Working conditions, pay and opportunities do not depend on gender.',
      'We consider gender in project design with partners, for example in programmes where women-majority cooperatives lead coastal restoration.',
    ],
  },
];
const toc = policies.map((p) => ({ id: p.id, label: p.name }));
---
<Legal
  title="Policies"
  heading="How we work responsibly"
  kicker={['About', 'Policies']}
  description="Reef Support's policies on data protection (GDPR), research data management and open data, safeguarding, anti-fraud and anti-corruption, and gender equality."
  updated="19 November 2026"
  toc={toc}
>
  <SubNav slot="subnav" label="About" links={subnav.about} />
  <p>These five policies apply to everyone who works for Reef Support, including students and interns, and to partners and subcontractors where a contract says so. They are approved by the Director of {company.legalName}.</p>
  {policies.map((p) => (
    <>
      <h2 id={p.id}>{p.name}</h2>
      <ul>{p.points.map((pt) => <li>{pt}</li>)}</ul>
    </>
  ))}
  <h2 id="questions">Questions</h2>
  <p>Questions about these policies, or a concern you want to raise, can go to <a href={`mailto:${company.email}`}>{company.email}</a>.</p>
</Legal>
