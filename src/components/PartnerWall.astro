---
// Logos render only with logo: "granted" (none yet), otherwise the plain name in the same cell.
interface Item { name: string; url?: string; note?: string; logo?: string; logoSrc?: string; publish?: boolean }
interface Props { items: (Item | string)[] }
const items = Astro.props.items
  .map((i) => (typeof i === 'string' ? { name: i } : i))
  .filter((i) => i.publish !== false);
---
<ul class="wall">
  {items.map((p) => {
    const inner = p.logo === 'granted' && p.logoSrc
      ? <img src={p.logoSrc} alt={p.name} loading="lazy" />
      : <span class="name">{p.name}{p.note && <span class="note">{p.note}</span>}</span>;
    return <li>{p.url ? <a href={p.url} rel="noopener">{inner}</a> : <div class="cell">{inner}</div>}</li>;
  })}
</ul>
<style>
  .wall {
    list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr);
    border-top: 1px solid var(--line); border-left: 1px solid var(--line);
  }
  li { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  a, .cell {
    display: flex; align-items: center; justify-content: flex-start; min-height: 112px; height: 100%;
    padding: var(--s-3); text-decoration: none; color: var(--ink);
  }
  a { transition: background-color 150ms, color 150ms; }
  a:hover { background: var(--mist); color: var(--ink); }
  a:focus-visible { outline-offset: -2px; }
  .name { font: 600 15px/1.35 var(--sans); display: flex; flex-direction: column; gap: 4px; }
  .note { font: 400 12px/1.4 var(--mono); letter-spacing: .04em; color: var(--mute); }
  img { max-height: 48px; width: auto; filter: grayscale(1); opacity: .6; transition: filter 150ms, opacity 150ms; }
  a:hover img { filter: none; opacity: 1; }
  @media (max-width: 1024px) { .wall { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 600px) { .wall { grid-template-columns: repeat(2, 1fr); } a, .cell { min-height: 88px; padding: var(--s-2); } }
</style>
