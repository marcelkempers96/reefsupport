---
import Base from './Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ToConfirm from '../components/ToConfirm.astro';
interface Props { title: string; description: string; updated?: string }
const { title, description, updated } = Astro.props;
---
<Base title={title} description={description}>
  <PageHeader kicker={['Legal']} title={title} />
  <section class="section">
    <div class="container">
      <p class="meta upd">{updated ? `Last updated ${updated}` : <ToConfirm note="legal review and publication date" />}</p>
      <div class="prose"><slot /></div>
    </div>
  </section>
</Base>
<style>.upd { color: var(--mute); margin-bottom: var(--s-4); }</style>
