---
import PhotoPlaceholder from './PhotoPlaceholder.astro';
interface Props { name: string; role: string; focus: string; colour: string; href?: string }
const { name, role, focus, colour, href } = Astro.props;
---
<article class="person">
  <PhotoPlaceholder label={`Portrait: ${name}`} ratio="4 / 5" />
  <div class="bar" style={`background: var(--${colour})`}></div>
  <div class="body">
    <p class="kicker">{role}</p>
    <h3>{href ? <a href={href}>{name}</a> : name}</h3>
    <p class="focus">{focus}</p>
  </div>
</article>
<style>
  .person { position: relative; border: 1px solid var(--line); background: var(--white); display: flex; flex-direction: column; transition: border-color 150ms; }
  .person:has(a):hover, .person:focus-within { border-color: var(--ink); }
  .person:focus-within { outline: 2px solid var(--ink); outline-offset: 2px; }
  .bar { height: var(--bar); }
  .body { flex: 1; padding: var(--s-3); }
  .kicker { margin-bottom: var(--s-1); }
  h3 a { text-decoration: underline 2px transparent; text-underline-offset: 4px; transition: color 150ms, text-decoration-color 150ms; }
  h3 a:focus-visible { outline: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .person:hover h3 a, h3 a:focus-visible { color: var(--teal); text-decoration-color: currentColor; }
  .focus { margin: var(--s-1) 0 0; font-size: var(--fs-small); line-height: 1.5; color: var(--mute); }
</style>
