---
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import StatusLabel from './StatusLabel.astro';
import Txt from './Txt.astro';
import { stripConfirm, isDev } from '../lib/confirm';
import type { Area, Project } from '../lib/data';
interface Props { project: Project; area: Area; headingLevel?: 'h2' | 'h3' }
const { project, area, headingLevel = 'h3' } = Astro.props;
const p = project.data;
const H = headingLevel;
const stripped = stripConfirm(p.years);
// In production an unconfirmed start year would leave a bare "to now": show nothing instead.
const years = isDev ? p.years : /^to\b/.test(stripped) ? '' : stripped;
---
<article class="card" data-area={p.area} data-country={p.country} data-status={p.status}>
  <PhotoPlaceholder label={p.image} />
  <div class="bar" style={`background: var(--${area.data.colour})`}></div>
  <div class="body">
    <p class="kicker">{area.data.name} · {p.country}</p>
    <H class="title"><a href={`/projects/${project.id}`}>{p.title}</a></H>
    <p class="summary">{p.summary}</p>
    <div class="foot">
      <span class="meta">{years && <Txt text={years} />}</span>
      <StatusLabel status={p.status} />
      {!p.publish && <p class="meta unpublished">Unpublished: hidden in production</p>}
    </div>
  </div>
</article>
<style>
  /* Six rows: image, bar, kicker, title, summary, foot. Inside a CardGrid the rows join the
     parent grid (subgrid) so kickers, titles and footers line up across a row of cards. */
  .card {
    position: relative; display: grid; grid-template-rows: auto auto auto auto 1fr auto;
    background: var(--white); border: 1px solid var(--line); transition: border-color 150ms;
  }
  @supports (grid-template-rows: subgrid) {
    .card { grid-row: span 6; grid-template-rows: subgrid; row-gap: 0; }
  }
  .card:hover, .card:focus-within { border-color: var(--ink); }
  .bar { height: var(--bar); }
  .body { display: contents; }
  .body > * { padding-inline: var(--s-3); margin: 0; }
  .kicker { padding-top: var(--s-3); margin-bottom: var(--s-1); align-self: start; }
  .title { font-size: var(--fs-h3); line-height: 1.3; letter-spacing: -0.01em; padding-bottom: var(--s-1); }
  .title a {
    text-decoration: underline 2px transparent; text-underline-offset: 4px;
    transition: color 150ms, text-decoration-color 150ms;
  }
  .title a::after { content: ''; position: absolute; inset: 0; }
  .title a:focus-visible { outline: none; }
  .card:focus-within { outline: 2px solid var(--ink); outline-offset: 2px; }
  .card:hover .title a, .title a:focus-visible { color: var(--teal); text-decoration-color: currentColor; }
  .summary { font-size: var(--fs-small); line-height: 1.5; color: var(--mute); max-width: none; padding-bottom: var(--s-3); }
  .foot {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-1) var(--s-2);
    padding-block: var(--s-2) var(--s-3); border-top: 1px solid var(--line-soft); margin-inline: var(--s-3); padding-inline: 0;
    color: var(--mute);
  }
  .unpublished { flex-basis: 100%; margin: 0; color: #8a5a00; }
</style>
