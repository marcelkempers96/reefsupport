---
// Step 1 shell. The full home page (video hero, facts strip, tiles, partner wall) is build step 3.
import Base from '../layouts/Base.astro';
---
<Base>
  <section class="section">
    <div class="container">
      <p class="kicker">Reef Support · Marine technology and research</p>
      <h1 style="font-size: var(--fs-display); font-weight: 800; line-height: 1.05; letter-spacing: -0.025em;">Evidence for healthy coasts</h1>
      <p class="lead" style="margin-top: var(--s-3);">We build AI models and monitoring methods for coral reefs, mangroves and coastal waters, and run them with the organisations that work on the water.</p>
      <p style="display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-4);">
        <a class="btn" href="/work">Explore our work</a>
        <a class="btn btn--secondary" href="/research/open-source">Try Coral AI</a>
      </p>
    </div>
  </section>
</Base>
