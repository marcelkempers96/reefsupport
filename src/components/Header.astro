---
import { cleanPath } from '../lib/seo';
import Logo from './Logo.astro';
import nav from '../data/nav.json';

type Child = { label: string; href: string; desc?: string; colour?: string; no?: string };
type Item = { label: string; href: string; overview?: string; intro?: string; wide?: boolean; children?: Child[] };

const items = nav.main as Item[];
const path = cleanPath(Astro.url.pathname);
const isActive = (href: string) => path === href || path.startsWith(href + '/');
// Items in the right half of the bar open their panel right-aligned so it stays on screen.
const alignRight = (i: number) => i >= Math.ceil(items.length / 2);
---
<header class="site-header" data-header>
  <div class="container bar">
    <Logo />

    <nav class="nav" aria-label="Main" id="site-nav" data-nav>
      <ul class="nav__list">
        {items.map((item, i) => (
          <li class:list={['nav__item', { 'has-children': item.children, 'is-current': isActive(item.href) }]} data-nav-item>
            <a href={item.href} class:list={['nav__link', { 'is-active': isActive(item.href) }]}
               aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
            {item.children && (
              <>
                <button class="nav__toggle" type="button" aria-expanded="false"
                        aria-controls={`sub-${i}`} data-sub-toggle>
                  <span class="visually-hidden">{item.label}: show pages</span>
                  <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
                </button>
                <div class:list={['sub', { 'sub--wide': item.wide, 'sub--right': alignRight(i) }]} id={`sub-${i}`} data-sub>
                  {item.intro && (
                    <div class="sub__head">
                      <p class="sub__intro">{item.intro}</p>
                      <a class="sub__overview" href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                        {item.overview ?? item.label}<span aria-hidden="true"> →</span>
                      </a>
                    </div>
                  )}
                  <ul class="sub__list">
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} class:list={['sub__link', { 'is-active': isActive(c.href) }]}
                           aria-current={path === c.href ? 'page' : undefined}>
                          <span class="sub__title">
                            {c.colour && <span class="sq" style={`background: var(--${c.colour})`} aria-hidden="true" />}
                            {c.no && <span class="sub__no meta" aria-hidden="true">{c.no}</span>}
                            <span>{c.label}</span>
                          </span>
                          {c.desc && <span class="sub__desc">{c.desc}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            )}
          </li>
        ))}
      </ul>
      <a href="/search" class:list={['nav__search', { 'is-active': path === '/search' }]} aria-current={path === '/search' ? 'page' : undefined}>
        <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="2"/><path d="M13 13l5 5" stroke="currentColor" stroke-width="2"/></svg>
        <span>Search</span>
      </a>
      <a href="/contact" class="btn nav__contact" aria-current={path === '/contact' ? 'page' : undefined}>Contact</a>
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span data-menu-label>Menu</span>
    </button>
  </div>
</header>

<script>
  const DESKTOP = '(min-width: 1081px)';
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menuBtn = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menuLabel = header?.querySelector<HTMLElement>('[data-menu-label]');
  const toggles = header ? Array.from(header.querySelectorAll<HTMLButtonElement>('[data-sub-toggle]')) : [];
  const isDesktop = () => window.matchMedia(DESKTOP).matches;

  const panelOf = (t: HTMLButtonElement) => document.getElementById(t.getAttribute('aria-controls') || '');
  const linksOf = (t: HTMLButtonElement) =>
    Array.from(panelOf(t)?.querySelectorAll<HTMLAnchorElement>('a') ?? []);
  const setSub = (t: HTMLButtonElement, open: boolean) => t.setAttribute('aria-expanded', String(open));
  const closeSubs = (except?: HTMLButtonElement) => toggles.forEach((t) => { if (t !== except) setSub(t, false); });

  const setMenu = (open: boolean) => {
    if (!header || !menuBtn || !menuLabel) return;
    header.classList.toggle('menu-open', open);
    menuBtn.setAttribute('aria-expanded', String(open));
    menuLabel.textContent = open ? 'Close' : 'Menu';
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) {
      // Open the group for the section the visitor is in, so the current page is visible straight away.
      closeSubs();
      const current = header.querySelector<HTMLButtonElement>('.is-current [data-sub-toggle]');
      if (current) setSub(current, true);
    }
  };

  menuBtn?.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));

  toggles.forEach((t) => {
    t.addEventListener('click', () => {
      const open = t.getAttribute('aria-expanded') !== 'true';
      if (isDesktop()) closeSubs(t);
      setSub(t, open);
    });
    // Arrow down on the toggle opens the panel and moves to its first link.
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown') return;
      e.preventDefault();
      if (isDesktop()) closeSubs(t);
      setSub(t, true);
      linksOf(t)[0]?.focus();
    });
    // Arrow keys move between links inside an open panel; Home and End jump to the ends.
    panelOf(t)?.addEventListener('keydown', (e) => {
      if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(e.key)) return;
      const links = linksOf(t);
      const idx = links.indexOf(document.activeElement as HTMLAnchorElement);
      if (idx < 0) return;
      e.preventDefault();
      const next =
        e.key === 'Home' ? 0 :
        e.key === 'End' ? links.length - 1 :
        e.key === 'ArrowDown' ? Math.min(idx + 1, links.length - 1) :
        idx - 1;
      if (next < 0) t.focus(); else links[next].focus();
    });
  });

  document.addEventListener('click', (e) => {
    if (header && !header.contains(e.target as Node) && isDesktop()) closeSubs();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = toggles.find((t) => t.getAttribute('aria-expanded') === 'true' && isDesktop());
    const hovered = header?.querySelector<HTMLElement>('[data-nav-item]:hover');
    if (open) { closeSubs(); open.focus(); }
    else if (header?.classList.contains('menu-open')) { setMenu(false); menuBtn?.focus(); }
    // A panel shown by mouse hover hides on Escape until the pointer leaves the item.
    if (hovered && isDesktop()) {
      hovered.classList.add('is-dismissed');
      hovered.addEventListener('mouseleave', () => hovered.classList.remove('is-dismissed'), { once: true });
    }
  });
  // Close a desktop panel when focus leaves its item.
  header?.querySelectorAll<HTMLElement>('[data-nav-item]').forEach((item) => {
    item.addEventListener('focusout', (e) => {
      if (!isDesktop()) return;
      if (!item.contains(e.relatedTarget as Node)) item.querySelector('[data-sub-toggle]')?.setAttribute('aria-expanded', 'false');
    });
  });
  window.matchMedia(DESKTOP).addEventListener('change', (m) => { if (m.matches) { setMenu(false); closeSubs(); } });
</script>

<style>
  .site-header {
    position: sticky; top: env(safe-area-inset-top); z-index: 50;
    background: var(--white); border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); height: var(--header-h); }

  .nav { display: flex; align-items: center; gap: var(--s-4); }
  .nav__list { display: flex; align-items: center; gap: var(--s-3); list-style: none; margin: 0; padding: 0; }
  .nav__item { position: relative; display: flex; align-items: center; gap: 4px; }
  .nav__link {
    font: 500 15px/1 var(--sans); text-decoration: none; color: var(--ink); white-space: nowrap;
    padding: 25px 0 23px; border-bottom: 2px solid transparent; transition: color 150ms, border-color 150ms;
  }
  .nav__link:hover { color: var(--teal); }
  .nav__link.is-active { border-bottom-color: var(--ink); font-weight: 600; }
  .nav__toggle {
    display: grid; place-items: center; width: 24px; height: 24px; padding: 0;
    background: none; border: 0; cursor: pointer; color: var(--ink);
  }
  .nav__toggle:hover { color: var(--teal); }
  .nav__toggle svg { transition: transform 150ms; }
  .nav__toggle[aria-expanded='true'] svg { transform: rotate(180deg); }

  /* Desktop panel */
  .sub {
    display: none; position: absolute; top: calc(100% + 1px); left: -24px; width: 400px;
    background: var(--white); border: 1px solid var(--line); border-top: 2px solid var(--ink);
  }
  .sub--wide { width: 640px; }
  .sub--right { left: auto; right: -12px; }
  .nav__toggle[aria-expanded='true'] + .sub { display: block; }
  @media (hover: hover) and (min-width: 1081px) {
    .nav__item:hover:not(.is-dismissed) > .sub { display: block; }
  }
  .sub__head {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--s-1) var(--s-3);
    padding: var(--s-2) var(--s-3); border-bottom: 1px solid var(--line); background: var(--mist);
  }
  .sub__intro { margin: 0; font-size: var(--fs-small); line-height: 1.5; color: var(--mute-dark); flex: 1 1 260px; }
  .sub__overview { font: 600 14px/1.4 var(--sans); white-space: nowrap; text-decoration: underline; text-underline-offset: 4px; }
  .sub__overview[aria-current='page'] { text-decoration-thickness: 2px; }
  .sub__list { list-style: none; margin: 0; padding: var(--s-1) 0; }
  @media (min-width: 1081px) {
    .sub--wide .sub__list { display: grid; grid-template-columns: 1fr 1fr; padding: 0; }
    .sub--wide .sub__list li { border-bottom: 1px solid var(--line-soft); }
    .sub--wide .sub__list li:nth-child(odd) { border-right: 1px solid var(--line-soft); }
    .sub--wide .sub__list li:nth-last-child(-n+2) { border-bottom: 0; }
  }
  .sub__link {
    display: block; padding: 12px var(--s-3); text-decoration: none; color: var(--ink);
    border-left: 3px solid transparent; transition: background-color 150ms, border-color 150ms;
  }
  .sub--wide .sub__link { padding: var(--s-2) var(--s-3); height: 100%; }
  .sub__link:hover { background: var(--mist); color: var(--ink); }
  .sub__link:hover .sub__title > span:last-child { text-decoration: underline; text-underline-offset: 3px; }
  .sub__link.is-active { border-left-color: var(--ink); background: var(--mist); }
  .sub__title { display: flex; align-items: center; gap: 10px; font: 600 15px/1.3 var(--sans); }
  .sub__no { color: var(--mute); }
  .sub__desc { display: block; margin-top: 4px; font: 400 13px/1.45 var(--sans); color: var(--mute); }
  .sq { width: 12px; height: 12px; flex: none; }

  .nav__contact { padding: 10px 18px; white-space: nowrap; }
  .nav__search {
    display: inline-flex; align-items: center; gap: 8px; font: 500 15px/1 var(--sans); text-decoration: none;
    padding: 23px 0 21px; border-bottom: 2px solid transparent;
  }
  .nav__search.is-active { border-bottom-color: var(--ink); }
  @media (min-width: 1081px) { .nav__search span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } }

  .menu-btn {
    display: none; padding: 10px 16px; background: var(--white); border: 2px solid var(--ink);
    font: 600 15px/1 var(--sans); cursor: pointer;
  }

  @media (min-width: 1081px) and (max-width: 1200px) {
    .nav { gap: var(--s-3); }
    .nav__list { gap: 20px; }
  }

  /* Mobile and tablet: full-width menu with collapsible groups */
  @media (max-width: 1080px) {
    .menu-btn { display: inline-block; }
    .nav {
      display: none; position: fixed; left: 0; right: 0;
      top: calc(var(--header-h) + env(safe-area-inset-top)); bottom: 0;
      flex-direction: column; align-items: stretch; gap: var(--s-3);
      padding: var(--s-2) max(var(--margin), env(safe-area-inset-right)) var(--s-5) max(var(--margin), env(safe-area-inset-left));
      background: var(--white); border-top: 1px solid var(--line); overflow-y: auto; overscroll-behavior: contain;
    }
    .menu-open .nav { display: flex; }
    .nav__list { flex-direction: column; align-items: stretch; gap: 0; }
    .nav__item { flex-wrap: wrap; border-bottom: 1px solid var(--line); gap: 0; }
    .nav__link { flex: 1; font-size: 18px; font-weight: 600; padding: 16px 0; border-bottom: 0; }
    .nav__link.is-active { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
    .nav__toggle { width: 48px; height: 48px; margin-right: -12px; }
    .nav__toggle svg { width: 14px; height: 9px; }
    .sub, .sub--wide { position: static; width: 100%; border: 0; }
    .nav__toggle[aria-expanded='true'] + .sub { display: block; }
    .sub__head { display: none; }
    .sub__list { padding: 0 0 var(--s-2); }
    .sub__link, .sub--wide .sub__link { padding: 8px 0 8px var(--s-2); }
    .sub__link:hover { background: none; color: var(--teal); }
    .sub__link.is-active { background: none; border-left-color: var(--ink); }
    .sub__desc { display: none; }
    .sub__title { font-weight: 500; font-size: 16px; }
    .sub__no { display: none; }
    .nav__contact { align-self: flex-start; }
    .nav__search { font-size: 18px; font-weight: 600; padding: 0; border: 0; }
  }
</style>
